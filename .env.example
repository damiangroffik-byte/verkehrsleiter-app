# Aus dem Supabase-Projekt: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Adresse der App (für Links in E-Mails)
NEXT_PUBLIC_APP_URL=https://verkehrsleiter-app.vercel.app

# Mailversand über IONOS (Postfach noreply@kraftverkehr-groffik.de)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=noreply@kraftverkehr-groffik.de
SMTP_PASSWORT=
MAIL_ABSENDER="Verkehrsleiter-App <noreply@kraftverkehr-groffik.de>"

# Langes Zufallswort, schützt /api/benachrichtigungen und /api/aufraeumen
BENACHRICHTIGUNG_GEHEIMNIS=

# Nur für das Aufräumen nach 1 Jahr (Project Settings > API Keys > Secret key)
SUPABASE_SECRET_KEY=
